# EXAMPLE ONLY — do not store real credentials here
APP_ENV=development
DATABASE_URL=postgresql://parking_user:change_me@localhost:5432/parking
AI_SERVICE_URL=http://localhost:8001
AI_CONFIDENCE_THRESHOLD=0.75
STALE_THRESHOLD_MINUTES=30
UPLOAD_MAX_MB=10
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
# Required to issue/verify JWT; set only in your untracked .env file
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# Local React dev origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# W3 camera reference frames (local private storage)
REFERENCE_IMAGE_DIR=backend/storage/reference-images
