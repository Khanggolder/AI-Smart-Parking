# Copy to compose.env and replace these values. Never commit compose.env.
# Use letters and numbers only for the password so it is valid in DATABASE_URL.
PARKING_POSTGRES_PASSWORD=replace_with_a_long_random_password
PARKING_JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
# Path to the EXTRACTED v0.1.0-rc2 directory containing model/ and threshold_candidate.json.
# Example on Windows: D:/path/to/ai-smart-parking-model-v0.1.0-rc2/v0.1.0-rc2
PARKING_MODEL_RELEASE_DIR=../ai-smart-parking-model-v0.1.0-rc2/v0.1.0-rc2
PARKING_WEB_PORT=8080
